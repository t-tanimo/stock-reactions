{
  "manifest_version": 3,
  "name": "Stock Reactions",
  "short_name": "Stock Reactions",
  "version": "1.1.0",
  "description": "Stockのメッセージに「ありがとう」「完了しました」のリアクションを追加します。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.stock-app.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
